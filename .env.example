# Copy to .env for local use. On Render, add these under Environment.
SECRET_KEY=change-me-to-a-long-random-string
# Paste your Neon connection string below (remove the leading #). Leave it commented to test with a local file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# First owner account (created automatically only if no owner exists yet)
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeThisNow!123
COMPANY_NAME=Shashwat Fincap
WEBSITE_URL=https://www.shashwatfincap.com

# Email sending (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=Shashwat Fincap

# Optional: WhatsApp Business Cloud API (leave blank to use click-to-send links only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Secret used by the daily auto-wish URL (/cron/daily?key=...)
CRON_KEY=another-long-random-string

# Days before a policy ends when the daily job sends an automatic renewal reminder
RENEWAL_REMINDER_DAYS=30,7,1

# Company email domain: employee/owner email IDs must end with it (leave empty to allow any address while testing)
COMPANY_EMAIL_DOMAIN=shashwatfincap.com

# Logo: put your file at static/logo.png (or .jpg/.svg/.webp). Optionally set a web address instead:
# LOGO_URL=https://www.shashwatfincap.com/Content/shashwatfincap.com/UploadedImage/RealImage/682logoimg.jpeg

# ---- WhatsApp Business Cloud API (messages go straight from each employee's company number) ----
WHATSAPP_TOKEN=
# Names of your APPROVED message templates (see README). Language code of those templates:
WA_TEMPLATE_BIRTHDAY=birthday_wish
WA_TEMPLATE_ANNIVERSARY=anniversary_wish
WA_TEMPLATE_RENEWAL=policy_renewal_reminder
WA_TEMPLATE_LANG=en

# ---- Email through an HTTPS service (REQUIRED on Render's free plan, which blocks SMTP ports) ----
# EMAIL_API=resend            # or: brevo   (verify your domain there, then any @yourdomain address can be the sender)
# EMAIL_API_KEY=
# MAIL_FROM_ADDRESS=info@shashwatfincap.com   # used when the owner has no company email set

# ---- ONE shared mail account (e.g. one Gmail) for the owner AND all employees ----
# SHARED_MAIL=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourcompany@gmail.com
# SMTP_PASSWORD=16-character-google-app-password

# ---- ONE Gmail for everyone WITHOUT App Password/SMTP (Gmail web API; works on Render free) ----
# Run: python get_gmail_token.py CLIENT_ID CLIENT_SECRET   and paste the lines it prints:
# EMAIL_API=gmail
# SHARED_MAIL=1
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=yourcompany@gmail.com
